FOLDER_PATH = "/content/drive/MyDrive/yourfolder"
CLIENT_SECRETS_FILE = "/content/drive/MyDrive/client_secrets.json"


TOKENS_DIR = "/content/drive/MyDrive/youtube_tokens"
os.makedirs(TOKENS_DIR, exist_ok=True)

SCOPES = ["https://www.googleapis.com/auth/youtube.upload", "https://www.googleapis.com/auth/youtube.readonly"]



def get_channel_details(credentials):
    """نام و شناسه کانال متصل شده را برمی‌گرداند"""
    try:
        yt = build('youtube', 'v3', credentials=credentials)
        response = yt.channels().list(mine=True, part='snippet').execute()
        if response.get('items'):
            channel_title = response['items'][0]['snippet']['title']
            channel_id = response['items'][0]['id']
            return yt, channel_title, channel_id
    except Exception as e:
        pass
    return None, None, None



def add_new_channel():
    print("\n➕ فرآیند اتصال کانال جدید:")
    if not os.path.exists(CLIENT_SECRETS_FILE):
        raise FileNotFoundError(f"❌ فایل {CLIENT_SECRETS_FILE} در درایو پیدا نشد.")

    flow = InstalledAppFlow.from_client_secrets_file(
        CLIENT_SECRETS_FILE,
        SCOPES,
        redirect_uri='http://localhost:8080/'
    )

    auth_url, _ = flow.authorization_url(prompt='select_account consent', access_type='offline')
    print("\n🔗 1. روی لینک زیر کلیک کنید:")
    print(auth_url)
    print("\n⚠️ خیلی مهم: پس از انتخاب جیمیل، از لیست کانال‌ها (Brand Accounts) دقیقاً روی کانال مدنظرتان کلیک کنید.")
    print("=" * 70)

    raw_input_data = input("2. آدرس نهایی مرورگر (URL) را اینجا Paste کنید:\n").strip()

    if "code=" in raw_input_data:
        parsed = urllib.parse.urlparse(raw_input_data)
        code = urllib.parse.parse_qs(parsed.query).get('code', [None])[0]
    else:
        code = raw_input_data

    if not code:
        raise ValueError("❌ کدی یافت نشد.")

    flow.fetch_token(code=code)
    credentials = flow.credentials

    # دریافت نام کانال
    yt, channel_title, channel_id = get_channel_details(credentials)
    if not channel_title:
        channel_title = f"Channel_{len(os.listdir(TOKENS_DIR)) + 1}"
        channel_id = "unknown_id"

    # ذخیره توکن با نام امن
    safe_filename = "".join([c if c.isalnum() else "_" for c in channel_title]) + ".pickle"
    token_path = os.path.join(TOKENS_DIR, safe_filename)

    with open(token_path, 'wb') as token:
        pickle.dump(credentials, token)

    print(f"\n🎉 کانال «{channel_title}» با موفقیت متصل و ذخیره شد!")
    return yt, channel_title



def select_channel():
    token_files = glob.glob(os.path.join(TOKENS_DIR, "*.pickle"))
    valid_channels = []

    # بررسی توکن‌های ذخیره شده
    for t_file in token_files:
        try:
            with open(t_file, 'rb') as f:
                creds = pickle.load(f)
            if creds and creds.expired and creds.refresh_token:
                creds.refresh(Request())
                with open(t_file, 'wb') as f:
                    pickle.dump(creds, f)

            yt, title, c_id = get_channel_details(creds)
            if title:
                valid_channels.append({"name": title, "creds": creds, "file": t_file, "youtube": yt})
        except Exception:
            continue

    print("\n" + "="*50)
    print("📺 کانال‌های متصل شده:")
    print("="*50)

    for idx, ch in enumerate(valid_channels, 1):
        print(f"[{idx}] {ch['name']}")

    new_channel_idx = len(valid_channels) + 1
    print(f"[{new_channel_idx}] ➕ اتصال یک کانال جدید")
    print("-" * 50)

    while True:
        try:
            choice = int(input(f"شماره کانال مورد نظر برای آپلود را انتخاب کنید (1 تا {new_channel_idx}): "))
            if 1 <= choice <= len(valid_channels):
                selected = valid_channels[choice - 1]
                print(f"🎯 کانال انتخاب شده: «{selected['name']}»")
                return selected['youtube'], selected['name']
            elif choice == new_channel_idx:
                yt, name = add_new_channel()
                return yt, name
            print("❌ شماره نامعتبر است.")
        except ValueError:
            print("❌ لطفاً عدد وارد کنید.")



def upload_to_youtube(youtube_service, channel_name, video_path, title, description="", tags=None, privacy_status="private"):
    print(f"\n🚀 در حال آماده‌سازی برای آپلود روی کانال «{channel_name}»...")
    print(f"📌 عنوان ویدیو: {title}")

    body = {
        "snippet": {
            "title": title,
            "description": description,
            "tags": tags or [],
            "categoryId": "20"  # دسته‌بندی Gaming
        },
        "status": {
            "privacyStatus": privacy_status,
            "selfDeclaredMadeForKids": False
        }
    }

    media = MediaFileUpload(video_path, chunksize=10*1024*1024, resumable=True)
    request = youtube_service.videos().insert(part="snippet,status", body=body, media_body=media)

    response = None
    while response is None:
        status, response = request.next_chunk()
        if status:
            print(f"⏳ پیشرفت آپلود: {int(status.progress() * 100)}%")

    video_id = response.get('id')
    print("\n" + "="*55)
    print(f"✅ ویدیو با موفقیت در کانال «{channel_name}» آپلود شد!")
    print(f"🔒 وضعیت انتشار: [{privacy_status.upper()}]")
    print(f"🔗 لینک مستقیم ویدیو: https://youtu.be/{video_id}")
    print(f"🛠️ لینک ویرایش در استودیو: https://studio.youtube.com/video/{video_id}/edit")
    print("="*55)
    return video_id



def main():
    # گام اول: انتخاب کانال
    youtube_service, channel_name = select_channel()

    # گام دوم: لیست کردن ویدیوهای پوشه درایو
    video_extensions = ('*.mp4', '*.mov', '*.avi', '*.mkv', '*.webm')
    video_files = []
    for ext in video_extensions:
        video_files.extend(glob.glob(os.path.join(FOLDER_PATH, ext)))
        video_files.extend(glob.glob(os.path.join(FOLDER_PATH, ext.upper())))

    if not video_files:
        print(f"\n❌ هیچ فایل ویدیویی در مسیر '{FOLDER_PATH}' یافت نشد.")
        return

    print("\n📁 ویدیوهای موجود در گوگل درایو:")
    print("-" * 65)
    for idx, filepath in enumerate(video_files, 1):
        filename = os.path.basename(filepath)
        size_mb = os.path.getsize(filepath) / (1024 * 1024)
        print(f"[{idx}] {filename:<40} ({size_mb:.1f} MB)")
    print("-" * 65)

    while True:
        try:
            choice = int(input(f"\nشماره فایل مورد نظر را وارد کنید (1 تا {len(video_files)}): "))
            if 1 <= choice <= len(video_files):
                selected_video = video_files[choice - 1]
                break
            print("❌ شماره خارج از محدوده است.")
        except ValueError:
            print("❌ لطفاً عدد وارد کنید.")

    # دریافت متادیتا
    default_title = os.path.splitext(os.path.basename(selected_video))[0]
    print(f"\n📌 فایل انتخاب شده: {os.path.basename(selected_video)}")

    custom_title = input(f"عنوان ویدیو [اینتر برای '{default_title}']: ").strip()
    title = custom_title if custom_title else default_title

    desc = input("توضیحات (Description) [اختیاری]: ").strip()
    tags_input = input("تگ‌ها (با کاما جدا کنید) [اختیاری]: ").strip()
    tags = [t.strip() for t in tags_input.split(",")] if tags_input else []

    print("\nوضعیت انتشار:")
    print("1. Private (خصوصی)")
    print("2. Unlisted (غیرعمومی / فقط با لینک)")
    print("3. Public (عمومی)")
    p_choice = input("انتخاب (1/2/3) [پیش‌فرض 1]: ").strip()
    privacy_map = {"1": "private", "2": "unlisted", "3": "public"}
    privacy_status = privacy_map.get(p_choice, "private")

    # تایید نهایی
    print("\n" + "="*50)
    print("🔍 خلاصه اطلاعات قبل از ارسال:")
    print(f"• کانال مقصد: {channel_name}")
    print(f"• نام فایل: {os.path.basename(selected_video)}")
    print(f"• عنوان ویدیو: {title}")
    print(f"• وضعیت انتشار: {privacy_status}")
    print("="*50)

    confirm = input("آیا اطلاعات بالا مورد تایید است و آپلود شروع شود؟ (y/n): ").strip().lower()
    if confirm in ['y', 'yes', 'بله', 'آره']:
        upload_to_youtube(
            youtube_service=youtube_service,
            channel_name=channel_name,
            video_path=selected_video,
            title=title,
            description=desc,
            tags=tags,
            privacy_status=privacy_status
        )
    else:
        print("🚫 عملیات آپلود لغو شد.")

# اجرای برنامه
main()
